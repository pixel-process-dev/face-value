{
  "run_name": "pixabay-light-v2",
  "data_source": "pixabay-v2",
  "metadata_path": "../data/processed/pixabay_v2/summaries/training_data.parquet",
  "output_dir": "../models/pixabay_light_aug_v2",
  
  "training": {
    "epochs": 30,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "optimizer": "adam",
    "optimizer_kwargs": {},
    "scheduler": "none",
    "scheduler_kwargs": {},
    "seed": 42
  },
  
  "data": {
    "image_size": 224,
    "transform_preset": "imagenet",
    "augmentation": "light"
  },
  
  "model": {
    "architecture": "resnet18",
    "pretrained": "IMAGENET1K_V1",
    "unfrozen_layers": ["layer3", "layer4", "fc"]
  },
  
  "mlflow": {
    "experiment_name": "emotion-movie-transfer"
  }
}
